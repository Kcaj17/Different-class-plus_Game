# ============================================================
# Inequality Tycoon (ไทยช่วยไทยพลัส 60/40) - Environment Variables
# ============================================================

# 1. Google Gemini AI API Key
# ขอรับ Key ได้ฟรีที่ https://aistudio.google.com/app/apikey
# หากเว้นว่างไว้ ระบบจะใช้งาน Fallback Story Generator โดยอัตโนมัติ
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# 2. พอร์ตสำหรับรันเว็บเซิร์ฟเวอร์ (ค่าเริ่มต้น: 3005)
PORT=3005

# 3. รหัส PIN สำหรับเข้าควบคุมหน้าจอ Master / Projector (ค่าเริ่มต้น: 2026)
ADMIN_PIN=2026

# 4. Public URL (ทางเลือก: เมื่อนำขึ้น Cloud / VPS / ngrok / domain)
# ใช้สำหรับสร้าง QR Code ให้ผู้เล่นสแกนเข้าห้องเกม
# หากเว้นว่างไว้ ระบบจะตรวจจับ IP/Domain อัตโนมัติจาก Browser Host
# ตัวอย่าง: PUBLIC_URL=http://192.168.1.50:3005 หรือ https://game.example.com
PUBLIC_URL=
